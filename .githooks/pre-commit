#!/usr/bin/env bash
./scripts/check_nav_link_guard.sh || exit 1

set -euo pipefail

# Run formatter from repository root regardless of current directory.
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

# Files staged for this commit (added/copied/modified/renamed). NUL-separated,
# so names with spaces or other odd characters are handled safely.
staged_files=()
while IFS= read -r -d '' file; do
  staged_files+=("${file}")
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

# Format only staged files that have no unstaged edits. A partially staged file
# is skipped: re-staging it after formatting would pull its unstaged hunks into
# the commit.
to_format=()
for file in "${staged_files[@]+"${staged_files[@]}"}"; do
  if git diff --quiet -- "${file}"; then
    to_format+=("${file}")
  else
    echo "pre-commit: not formatting partially staged file: ${file}" >&2
  fi
done

echo "Running clang-format fix before commit..."
if ((${#to_format[@]})); then
  ./bin/clang-format-fix "${to_format[@]}"
  git add -- "${to_format[@]}"
fi
